        <input type="hidden" id="edit-task-id" />
        
        <div>
          <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Title</label>
          <input 
            type="text" 
            id="edit-task-title" 
            required
            class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] rounded-[6px] p-2 text-[14px] text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3]" 
          />
        </div>

        <div>
          <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Notes & Description</label>
          <textarea 
            id="edit-task-desc" 
            rows="3"
            class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] rounded-[6px] p-2 text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3]"
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Priority</label>
            <select id="edit-task-priority" class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-xs rounded-[6px] p-2 text-[#171717] dark:text-white">
              <option value="p1">P1 — Urgent & Important</option>
              <option value="p2">P2 — High</option>
              <option value="p3">P3 — Medium</option>
              <option value="p4">P4 — Low</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Status</label>
            <select id="edit-task-status" class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-xs rounded-[6px] p-2 text-[#171717] dark:text-white">
              <option value="inbox">Backlog / Inbox</option>
              <option value="todo">Ready / Todo</option>
              <option value="in_progress">In Progress</option>
              <option value="review">Review</option>
              <option value="completed">Completed</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Due Date</label>
            <input type="date" id="edit-task-date" class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-xs rounded-[6px] p-2 text-[#171717] dark:text-white" />
          </div>

          <div>
            <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Est. Pomodoros</label>
            <input type="number" min="1" max="20" id="edit-task-poms" class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-xs rounded-[6px] p-2 text-[#171717] dark:text-white" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono uppercase text-[#8f8f8f] mb-1">Tags</label>
          <input type="text" id="edit-task-tags" class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-xs rounded-[6px] p-2 text-[#171717] dark:text-white" />
        </div>

        <!-- Subtasks Checklist in Edit Modal -->
        <div class="pt-2">
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-mono uppercase text-[#8f8f8f]">Checklist Subtasks</label>
            <button type="button" id="modal-add-subtask-btn" class="text-[11px] text-[#0070f3] hover:underline">+ Add step</button>
          </div>
          <div id="modal-subtasks-list" class="space-y-1.5 max-h-36 overflow-y-auto"></div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
          <button type="button" id="modal-delete-btn" class="px-3 py-1.5 text-xs text-[#ee0000] hover:bg-[#ee0000]/10 rounded-[6px] transition-colors">
            Delete Task
          </button>
          <div class="flex gap-2">
            <button type="button" id="cancel-edit-modal" class="px-3 py-1.5 text-xs rounded-[6px] border border-[#ebebeb] dark:border-[#222222] text-[#4d4d4d] dark:text-[#a1a1a1]">
              Cancel
            </button>
            <button type="submit" class="px-4 py-1.5 text-xs font-medium bg-[#171717] dark:bg-white text-white dark:text-[#171717] rounded-[6px]">
              Save Changes
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Command Palette Modal (Cmd+K) -->
  <div id="cmd-palette-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden flex items-start justify-center pt-20 p-4">
    <div class="w-full max-w-xl rounded-[12px] bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#222222] shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-100">
      <div class="flex items-center px-4 border-b border-[#ebebeb] dark:border-[#222222]">
        <svg class="w-4 h-4 text-[#8f8f8f] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input 
          type="text" 
          id="cmd-input" 
          placeholder="Type a command or search tasks..."
          autocomplete="off"
          class="w-full bg-transparent border-none p-3.5 text-[14px] text-[#171717] dark:text-white placeholder-[#8f8f8f] focus:outline-none"
        />
        <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-[#f2f2f2] dark:bg-[#1a1a1a] text-[#8f8f8f] rounded">ESC</kbd>
      </div>

      <div id="cmd-results" class="max-h-72 overflow-y-auto p-2 space-y-1 text-xs">
        <!-- Injected command items -->
      </div>
    </div>
  </div>

  <!-- Shortcuts Reference Modal -->
  <div id="shortcuts-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="w-full max-w-md rounded-[12px] bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#222222] shadow-2xl p-5 space-y-4">
      <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-2">
        <h3 class="font-semibold text-[14px]">Keyboard Shortcuts</h3>
        <button id="close-shortcuts-modal" class="text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white">✕</button>
      </div>
      <div class="space-y-2 text-xs">
        <div class="flex justify-between py-1 border-b border-[#ebebeb] dark:border-[#1f1f1f]">
          <span class="text-[#4d4d4d] dark:text-[#a1a1a1]">Focus quick add bar</span>
          <kbd class="font-mono bg-[#f2f2f2] dark:bg-[#1c1c1c] px-2 py-0.5 rounded">N</kbd>
        </div>
        <div class="flex justify-between py-1 border-b border-[#ebebeb] dark:border-[#1f1f1f]">
          <span class="text-[#4d4d4d] dark:text-[#a1a1a1]">Open Command Palette</span>
          <kbd class="font-mono bg-[#f2f2f2] dark:bg-[#1c1c1c] px-2 py-0.5 rounded">⌘ / Ctrl + K</kbd>
        </div>
        <div class="flex justify-between py-1 border-b border-[#ebebeb] dark:border-[#1f1f1f]">
          <span class="text-[#4d4d4d] dark:text-[#a1a1a1]">Switch views (1-5)</span>
          <kbd class="font-mono bg-[#f2f2f2] dark:bg-[#1c1c1c] px-2 py-0.5 rounded">1, 2, 3, 4, 5</kbd>
        </div>
        <div class="flex justify-between py-1 border-b border-[#ebebeb] dark:border-[#1f1f1f]">
          <span class="text-[#4d4d4d] dark:text-[#a1a1a1]">Toggle Focus/Pomodoro</span>
          <kbd class="font-mono bg-[#f2f2f2] dark:bg-[#1c1c1c] px-2 py-0.5 rounded">F</kbd>
        </div>
        <div class="flex justify-between py-1 border-b border-[#ebebeb] dark:border-[#1f1f1f]">
          <span class="text-[#4d4d4d] dark:text-[#a1a1a1]">Close open modal</span>
          <kbd class="font-mono bg-[#f2f2f2] dark:bg-[#1c1c1c] px-2 py-0.5 rounded">ESC</kbd>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Footer -->
  <footer class="mt-auto border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-6 text-xs text-[#8f8f8f] dark:text-[#707070]">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span>Engineered with Geist Design System</span>
        <span>•</span>
        <span>Astro + Tailwind CSS v4</span>
      </div>
      <div class="flex items-center gap-4">
        <span>Offline-first LocalDB</span>
        <button id="footer-reset-btn" class="hover:text-[#171717] dark:hover:text-white transition-colors">Reset Database</button>
      </div>
    </div>
  </footer>
</div>

<script>
  import { TodoController } from '../scripts/app';

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', () => {
        new TodoController();
      });
    } else {
      new TodoController();
    }
  }
</script>
