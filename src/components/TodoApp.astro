---
// src/components/TodoApp.astro
---

<div id="todo-app-root" class="min-h-screen bg-[#fafafa] dark:bg-[#000000] text-[#171717] dark:text-[#ededed] font-sans antialiased flex flex-col transition-colors duration-200">
  
  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-30 w-full bg-[#fafafa]/90 dark:bg-[#000000]/90 backdrop-blur-md border-b border-[#ebebeb] dark:border-[#222222]">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
      
      <!-- Brand Wordmark & Eyebrow -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0070f3] rounded-[6px] px-1 py-0.5">
          <!-- Vercel-style geometric triangle logo -->
          <svg class="w-4 h-4 fill-current text-[#171717] dark:text-white group-hover:scale-105 transition-transform" viewBox="0 0 116 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M57.5 0L115 100H0L57.5 0Z" />
          </svg>
          <span class="font-semibold tracking-tight text-[15px]">GEIST<span class="text-[#8f8f8f] dark:text-[#707070] font-normal mx-1">/</span>TASKS</span>
        </a>
        <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-[6px] text-[11px] font-mono font-medium uppercase tracking-wider bg-[#f2f2f2] dark:bg-[#1a1a1a] text-[#8f8f8f] dark:text-[#707070] border border-[#ebebeb] dark:border-[#262626]">
          v2.4 Pro
        </span>
      </div>

      <!-- Center Search & Command Trigger -->
      <div class="flex-1 max-w-md hidden md:flex items-center">
        <button 
          id="open-cmd-btn"
          type="button"
          class="w-full flex items-center justify-between px-3 py-1.5 text-[13px] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] border border-[#ebebeb] dark:border-[#222222] hover:border-[#d4d4d4] dark:hover:border-[#383838] rounded-[6px] text-[#8f8f8f] dark:text-[#707070] transition-colors shadow-[0_1px_2px_rgba(0,0,0,0.02)]"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Search or type a command...</span>
          </span>
          <kbd class="hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono bg-[#fafafa] dark:bg-[#161616] text-[#8f8f8f] dark:text-[#707070] border border-[#ebebeb] dark:border-[#262626] rounded-[4px]">
            <span>⌘</span>K
          </kbd>
        </button>
      </div>

      <!-- Right Action Controls -->
      <div class="flex items-center gap-2">
        <!-- Quick Pomodoro Timer Status -->
        <button 
          id="nav-pomo-btn"
          class="flex items-center gap-2 px-2.5 py-1.5 rounded-[6px] text-[12px] font-mono border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:border-[#0070f3] dark:hover:border-[#0070f3] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all"
          title="Toggle Focus / Pomodoro Timer"
        >
          <span class="w-2 h-2 rounded-full bg-[#ff4d4d] animate-pulse"></span>
          <span id="nav-pomo-time">25:00</span>
        </button>

        <!-- Sound Toggle -->
        <button 
          id="sound-toggle-btn" 
          type="button" 
          aria-label="Toggle UI Audio feedback"
          class="w-8 h-8 flex items-center justify-center rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-colors"
          title="Sound Effects (Enabled)"
        >
          <svg id="sound-on-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
          <svg id="sound-off-icon" class="w-3.5 h-3.5 hidden text-[#8f8f8f]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        </button>

        <!-- Theme Switcher -->
        <button 
          id="theme-toggle-btn" 
          type="button" 
          aria-label="Toggle Theme"
          class="w-8 h-8 flex items-center justify-center rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-colors"
          title="Toggle Light / Dark theme"
        >
          <!-- Sun icon (for dark mode) -->
          <svg class="w-3.5 h-3.5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <!-- Moon icon (for light mode) -->
          <svg class="w-3.5 h-3.5 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>

        <!-- Keyboard Shortcuts Help -->
        <button 
          id="shortcuts-btn" 
          type="button" 
          aria-label="Keyboard Shortcuts"
          class="hidden sm:flex w-8 h-8 items-center justify-center rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-colors"
          title="Keyboard shortcuts (?)"
        >
          <span class="text-xs font-mono font-medium">?</span>
        </button>

        <!-- Marketing Pill CTA for New Task -->
        <button 
          id="hero-new-task-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 text-[13px] font-medium bg-[#171717] hover:bg-black dark:bg-[#ededed] dark:hover:bg-white text-white dark:text-[#171717] rounded-full shadow-sm hover:shadow transition-all active:scale-[0.98]"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>New Task</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Header Band with Mesh Gradient -->
  <section class="relative geist-hero-mesh border-b border-[#ebebeb] dark:border-[#222222] py-8 sm:py-10 transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
      
      <!-- Eyebrow & Hero Title -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-[#0070f3]">
              // Developer Productivity Engine
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#00dfd8]"></span>
            <span id="live-date-str" class="text-[12px] font-mono text-[#8f8f8f] dark:text-[#707070]"></span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-1.8px] sm:tracking-[-2.4px] text-[#171717] dark:text-white">
            High-velocity task orchestration.
          </h1>
          <p class="mt-2 text-[#4d4d4d] dark:text-[#a1a1a1] text-[15px] max-w-xl">
            Streamlined workflow management with Eisenhower quadrants, Kanban pipelines, and integrated Pomodoro execution.
          </p>
        </div>

        <!-- Productivity Telemetry Cards Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 shrink-0">
          <div class="p-3 rounded-[8px] bg-white/80 dark:bg-[#0a0a0a]/80 backdrop-blur border border-[#ebebeb] dark:border-[#222222] shadow-[0_1px_2px_rgba(0,0,0,0.02)] min-w-[100px]">
            <span class="block text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#707070]">Active</span>
            <span id="metric-active-count" class="text-xl font-semibold tracking-tight text-[#171717] dark:text-white">0</span>
          </div>
          <div class="p-3 rounded-[8px] bg-white/80 dark:bg-[#0a0a0a]/80 backdrop-blur border border-[#ebebeb] dark:border-[#222222] shadow-[0_1px_2px_rgba(0,0,0,0.02)] min-w-[100px]">
            <span class="block text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#707070]">Done Today</span>
            <span id="metric-done-count" class="text-xl font-semibold tracking-tight text-[#0070f3]">0</span>
          </div>
          <div class="p-3 rounded-[8px] bg-white/80 dark:bg-[#0a0a0a]/80 backdrop-blur border border-[#ebebeb] dark:border-[#222222] shadow-[0_1px_2px_rgba(0,0,0,0.02)] min-w-[100px]">
            <span class="block text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#707070]">Velocity</span>
            <span id="metric-velocity" class="text-xl font-semibold tracking-tight text-[#171717] dark:text-white">0%</span>
          </div>
          <div class="p-3 rounded-[8px] bg-white/80 dark:bg-[#0a0a0a]/80 backdrop-blur border border-[#ebebeb] dark:border-[#222222] shadow-[0_1px_2px_rgba(0,0,0,0.02)] min-w-[100px]">
            <span class="block text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#707070]">Streak</span>
            <span id="metric-streak" class="text-xl font-semibold tracking-tight text-[#ff0080]">3d</span>
          </div>
        </div>
      </div>

      <!-- Category Navigation Pills Strip -->
      <div class="mt-8 flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-[13px] font-medium">
        <button data-view="list" class="view-tab-btn active-tab px-3.5 py-1.5 rounded-full border border-transparent bg-[#171717] text-white dark:bg-white dark:text-[#171717] transition-all whitespace-nowrap">
          <span>All Tasks</span>
          <span id="badge-all" class="ml-1.5 px-1.5 py-0.2 text-[10px] font-mono rounded-full bg-white/20 dark:bg-black/20">0</span>
        </button>
        <button data-view="today" class="view-tab-btn px-3.5 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all whitespace-nowrap">
          <span>Today</span>
          <span id="badge-today" class="ml-1.5 px-1.5 py-0.2 text-[10px] font-mono rounded-full bg-[#f2f2f2] dark:bg-[#222222]">0</span>
        </button>
        <button data-view="upcoming" class="view-tab-btn px-3.5 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all whitespace-nowrap">
          <span>Upcoming</span>
        </button>
        <button data-view="matrix" class="view-tab-btn px-3.5 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all whitespace-nowrap">
          <span>Eisenhower Matrix</span>
        </button>
        <button data-view="kanban" class="view-tab-btn px-3.5 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all whitespace-nowrap">
          <span>Kanban Board</span>
        </button>
        <button data-view="focus" class="view-tab-btn px-3.5 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all whitespace-nowrap">
          <span>Focus Mode</span>
        </button>
        <button data-view="analytics" class="view-tab-btn px-3.5 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all whitespace-nowrap">
          <span>Analytics</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="flex-1 max-w-[1240px] w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
    
    <!-- Smart Interactive Add Task Card -->
    <div id="quick-add-container" class="rounded-[12px] bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#222222] shadow-[0_1px_2px_rgba(0,0,0,0.02)] p-3 sm:p-4 transition-all focus-within:border-[#171717] dark:focus-within:border-[#888888]">
      <form id="add-task-form" class="space-y-3">
        <!-- Main title input -->
        <div class="flex items-center gap-3">
          <span class="text-[#8f8f8f] dark:text-[#707070] shrink-0 pl-1">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
          <input 
            type="text" 
            id="task-input-title" 
            placeholder="What needs to be done? (Try 'Refactor edge routing !p1 #infra @today')" 
            autocomplete="off"
            required
            class="flex-1 bg-transparent border-none text-[15px] text-[#171717] dark:text-white placeholder-[#8f8f8f] dark:placeholder-[#666666] focus:outline-none"
          />
          <button 
            type="button" 
            id="toggle-expand-form"
            class="px-2 py-1 text-xs text-[#8f8f8f] dark:text-[#707070] hover:text-[#171717] dark:hover:text-white rounded-[6px] border border-transparent hover:border-[#ebebeb] dark:hover:border-[#222222]"
            title="Expand task options"
          >
            Options ▾
          </button>
          <button 
            type="submit" 
            class="px-3 py-1.5 text-[13px] font-medium bg-[#171717] dark:bg-[#ededed] text-white dark:text-[#171717] hover:opacity-90 rounded-[6px] transition-opacity"
          >
            Add
          </button>
        </div>

        <!-- Expandable Detail Options -->
        <div id="expanded-options" class="hidden pt-3 border-t border-[#ebebeb] dark:border-[#1f1f1f] space-y-3">
          <div>
            <textarea 
              id="task-input-desc" 
              placeholder="Description or markdown notes (optional)..." 
              rows="2"
              class="w-full bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] rounded-[6px] p-2.5 text-[13px] text-[#171717] dark:text-white placeholder-[#8f8f8f] dark:placeholder-[#666666] focus:outline-none focus:border-[#0070f3]"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-3 text-[13px]">
            <!-- Priority selector -->
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-mono uppercase text-[#8f8f8f]">Priority:</span>
              <select id="task-input-priority" class="bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-[#171717] dark:text-white text-xs rounded-[6px] px-2 py-1 focus:outline-none">
                <option value="p1">P1 — Urgent & Important</option>
                <option value="p2">P2 — High Priority</option>
                <option value="p3" selected>P3 — Medium</option>
                <option value="p4">P4 — Low Priority</option>
              </select>
            </div>

            <!-- Due Date -->
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-mono uppercase text-[#8f8f8f]">Due:</span>
              <input 
                type="date" 
                id="task-input-date" 
                class="bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-[#171717] dark:text-white text-xs rounded-[6px] px-2 py-1 focus:outline-none"
              />
              <button type="button" class="quick-date-btn text-[11px] px-2 py-0.5 rounded-[4px] bg-[#f2f2f2] dark:bg-[#1c1c1c] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white" data-offset="0">Today</button>
              <button type="button" class="quick-date-btn text-[11px] px-2 py-0.5 rounded-[4px] bg-[#f2f2f2] dark:bg-[#1c1c1c] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white" data-offset="1">Tomorrow</button>
            </div>

            <!-- Tags input -->
            <div class="flex items-center gap-1.5 flex-1 min-w-[200px]">
              <span class="text-xs font-mono uppercase text-[#8f8f8f]">Tags:</span>
              <input 
                type="text" 
                id="task-input-tags" 
                placeholder="frontend, api, bug (comma separated)"
                class="flex-1 bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-[#171717] dark:text-white text-xs rounded-[6px] px-2 py-1 focus:outline-none"
              />
            </div>

            <!-- Estimated Pomodoros -->
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-mono uppercase text-[#8f8f8f]">Est. ⏱️:</span>
              <input 
                type="number" 
                id="task-input-poms" 
                min="1" 
                max="12" 
                value="1" 
                class="w-14 bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#222222] text-[#171717] dark:text-white text-xs rounded-[6px] px-2 py-1 focus:outline-none"
              />
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Filter & Sort Toolbar Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
      <!-- Left Filters -->
      <div class="flex items-center flex-wrap gap-2">
        <!-- Priority Filter -->
        <div class="flex items-center rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] p-0.5 text-xs font-medium">
          <button data-filter-p="all" class="filter-p-btn active-filter px-2.5 py-1 rounded-[4px] bg-[#171717] text-white dark:bg-white dark:text-[#171717]">All</button>
          <button data-filter-p="p1" class="filter-p-btn px-2 py-1 rounded-[4px] text-[#ee0000] hover:bg-[#f2f2f2] dark:hover:bg-[#1c1c1c]">P1</button>
          <button data-filter-p="p2" class="filter-p-btn px-2 py-1 rounded-[4px] text-[#f5a623] hover:bg-[#f2f2f2] dark:hover:bg-[#1c1c1c]">P2</button>
          <button data-filter-p="p3" class="filter-p-btn px-2 py-1 rounded-[4px] text-[#0070f3] hover:bg-[#f2f2f2] dark:hover:bg-[#1c1c1c]">P3</button>
          <button data-filter-p="p4" class="filter-p-btn px-2 py-1 rounded-[4px] text-[#8f8f8f] hover:bg-[#f2f2f2] dark:hover:bg-[#1c1c1c]">P4</button>
        </div>

        <!-- Tag dropdown/chips container -->
        <div id="dynamic-tags-container" class="flex items-center gap-1.5 flex-wrap">
          <!-- Dynamically injected active tags -->
        </div>
      </div>

      <!-- Right Sort & Action Dropdown -->
      <div class="flex items-center gap-2">
        <select id="sort-select" class="bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#222222] text-[#4d4d4d] dark:text-[#a1a1a1] text-xs rounded-[6px] px-2.5 py-1.5 focus:outline-none">
          <option value="created-desc">Newest First</option>
          <option value="due-asc">Due Date (Earliest)</option>
          <option value="priority-asc">Priority (P1 → P4)</option>
          <option value="title-asc">Alphabetical (A-Z)</option>
        </select>

        <!-- Batch actions menu trigger -->
        <button 
          id="batch-menu-btn" 
          class="px-2.5 py-1.5 rounded-[6px] text-xs font-medium border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] hover:bg-[#f7f7f8] dark:hover:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1]"
        >
          Manage Data ▾
        </button>
      </div>
    </div>

    <!-- Batch Management Modal / Popover -->
    <div id="batch-menu-dropdown" class="hidden relative z-20">
      <div class="absolute right-0 top-1 w-64 rounded-[8px] bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#222222] shadow-xl p-2 text-[13px] space-y-1">
        <button id="action-export-json" class="w-full text-left px-2.5 py-1.5 rounded-[4px] hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] flex items-center justify-between">
          <span>Export tasks as JSON</span>
          <span class="text-[10px] font-mono text-[#8f8f8f]">.json</span>
        </button>
